{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yufeng://procedures/http-inspection-baseline/schema/policy.v1.json",
  "title": "PolicyCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "scope", "predicate", "action", "dependencies", "governance", "lifecycle"],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "methods"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "route_template": { "type": "string" },
        "path_prefix": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "content_types": { "type": "array", "items": { "type": "string" } },
        "target_selectors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_keys", "require_match_present"],
      "properties": {
        "detection_keys": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "min_anomaly_score": { "type": "number" },
        "require_match_present": { "type": "boolean" },
        "coverage_requirement": { "type": "string" }
      }
    },
    "action": { "type": "string", "enum": ["log", "block"] },
    "dependencies": { "type": "object" },
    "governance": { "type": "object" },
    "lifecycle": { "type": "object" },
    "rollout": { "type": "object" }
  }
}
