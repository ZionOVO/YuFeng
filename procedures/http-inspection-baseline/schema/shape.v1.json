{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yufeng://procedures/http-inspection-baseline/schema/shape.v1.json",
  "title": "ShapeSourceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["methods", "constraints"],
  "properties": {
    "methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "route_template": { "type": "string" },
    "path_prefix": { "type": "string" },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "max_len", "charset"],
        "properties": {
          "selector": { "type": "string", "minLength": 1 },
          "min_len": { "type": "integer", "minimum": 0 },
          "max_len": { "type": "integer", "minimum": 1 },
          "charset": { "type": "string", "enum": ["ascii_print", "digit", "alpha", "hex", "uuid"] }
        }
      }
    }
  }
}
